[Unit]
Description=dullahan encrypted Postgres backup
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
# Root: the script drops to the postgres user for pg_dump (via setpriv, not
# sudo — see NoNewPrivileges below) and writes under /var/backups.
User=root
ExecStart=/usr/local/bin/dullahan-backup
StandardOutput=journal
StandardError=journal

# A failed backup must be loud. Without this the timer's next run is the only
# hint anything happened, and OnFailure is what surfaces it in `systemctl
# --failed`.
TimeoutStartSec=1800

# Keep in mind when editing the script: this makes sudo unusable, even for a
# root unit dropping privileges. Use setpriv.
NoNewPrivileges=true
PrivateTmp=true
# Hides /root, so anything reading a dotfile there (rclone's config, most
# obviously) must be pointed at /etc/dullahan instead.
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups
