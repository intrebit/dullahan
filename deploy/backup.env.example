# Settings for dullahan-backup.sh and dullahan-restore-drill.sh.
# Install as /etc/dullahan/backup.env, mode 0600, owned by root — it holds no
# secrets itself, but it names the files that are.

# Databases to dump, space separated. One Postgres cluster often hosts more than
# dullahan; dumping a co-tenant costs nothing and losing it costs the same as
# losing this one.
BACKUP_DATABASES="dullahan"

# Where runs land locally before upload, and where they are pruned from.
BACKUP_DIR=/var/backups/dullahan

# Grandfather-father-son retention for the LOCAL copies. Remote retention is set
# with a bucket lifecycle rule instead, deliberately — see docs/deploy.md.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# ---------------------------------------------------------------------------
# Encryption. Generate the keypair with:
#
#     age-keygen -o /etc/dullahan/backup-identity.txt
#     grep 'public key' /etc/dullahan/backup-identity.txt   # -> age1...
#     echo age1... > /etc/dullahan/backup-recipients.txt
#     chmod 600 /etc/dullahan/backup-identity.txt
#
# !! COPY backup-identity.txt OFF THIS MACHINE AND STORE IT SOMEWHERE ELSE. !!
#
# The private key is the only thing that can read these backups. Leaving the only
# copy on the host being backed up means a dead disk takes the backups with it —
# you would be paying for object storage full of files nobody can open. Put it in
# a password manager or another machine, today, before the first run.
# ---------------------------------------------------------------------------
AGE_RECIPIENTS_FILE=/etc/dullahan/backup-recipients.txt
AGE_IDENTITY_FILE=/etc/dullahan/backup-identity.txt

# ---------------------------------------------------------------------------
# Off-box destination, as an rclone remote. Any S3-compatible provider works.
#
# Cloudflare R2 is the recommended one here, for a specific reason: it charges
# nothing for egress. The restore drill *downloads* the newest backup every month
# to prove it can be restored, and on providers that bill egress that verification
# is the thing you end up quietly switching off. 10 GB of storage is free, which
# is many times over what this data needs.
#
#     apt install rclone
#     rclone config
#       n) new remote     name: r2      storage: s3      provider: Cloudflare
#       access_key_id / secret_access_key: from an R2 API token
#       endpoint: https://<accountid>.r2.cloudflarestorage.com
#       region: auto
#     rclone mkdir r2:dullahan-backups
#     rclone ls r2:dullahan-backups     # confirm before relying on it
#
# Leave empty and backups stay on this host only — which is the same disk they
# exist to survive the loss of. The script warns every run while it is unset.
# ---------------------------------------------------------------------------
RCLONE_REMOTE=

# ---------------------------------------------------------------------------
# OPTIONAL external watchdog (healthchecks.io free tier, or any equivalent).
#
# Not required: `dullahan --selfcheck` already alerts when the newest run in
# $BACKUP_DIR goes stale, so a backup job that dies quietly is caught from the
# inside. What a watchdog adds is the case nothing on this box can report — the
# box itself being gone. Set these when you want that covered.
#
# Suggested schedules: backup = 1 day + 2h grace, drill = 1 month + 1d grace.
# ---------------------------------------------------------------------------
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_DRILL_URL=

# Restore-drill settings. DRILL_SOURCE_DB is the database whose dump gets
# restored; DRILL_DB is the throwaway it is restored into and dropped after.
DRILL_SOURCE_DB=dullahan
DRILL_DB=dullahan_restore_drill
