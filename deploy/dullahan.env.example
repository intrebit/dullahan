DATABASE_URL=postgres://dullahan:CHANGEME@127.0.0.1:5432/dullahan
BIND_ADDR=127.0.0.1:3011
# Tenants live in the `sites` table, not here — register them with POST /sites.
# While that table is empty, any site id is accepted.
# Required to read /stats/*. Generate with: openssl rand -hex 24
# If unset, /stats/* is publicly readable (NOT recommended for the public internet).
ADMIN_TOKEN=
# Comma-separated list of origins allowed to call /stats/*. Unset = any origin.
# Set to your dashboard URL so a browser elsewhere can't read responses even
# if the admin token leaks into a page.
# STATS_ORIGINS=https://stats.example.com
# Comma-separated origins allowed to read the product catalog (GET /products and
# the /products/:slug/view ping) cross-origin from a browser. Unset = any origin
# (the published catalog is public). Set to your storefront URL to restrict.
# PRODUCT_ORIGINS=https://shop.example.com
# Set to 1 once the deploy is fronted by HTTPS so HSTS is sent.
# BEHIND_TLS=1
# Set to 1 only when a trusted reverse proxy sets x-forwarded-for / x-real-ip.
# TRUST_PROXY_HEADERS=1
# Opt-in anonymized sessions (unique visitors, bounce rate, browser/OS family).
# Off by default: with it off /collect does not use IP beyond transient rate
# limiting and does not read User-Agent.
# SESSIONS_ENABLED=1
# Delete analytics events older than N days. Unset = keep forever, which is the
# only unbounded table in the schema. The sweep runs at startup and every 6h.
# RETENTION_DAYS=365
# Log format: text (default) or json (structured).
# LOG_FORMAT=json
RUST_LOG=info,sqlx=warn
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@example.com   # default sender; a site's `email_from` overrides it
# EMAIL_FROM_NAME=dullahan
# Contact recipients are per-tenant: set `contact_to` on the site's row via
# POST/PATCH /sites. A submission naming a site with no recipient gets a 503,
# never another tenant's inbox.
# Currency for the product catalog (/products). ISO-4217 code; prices are stored
# as integer minor units (price_cents) and this is echoed in each response so the
# frontend can format. Default EUR.
# SHOP_CURRENCY=EUR

# --- Monitoring (`dullahan --selfcheck`, run by dullahan-selfcheck.timer) ------
# Where check failures are mailed. This is the OPERATOR's address — the checks are
# about the process and the host, not about any one tenant. Needs RESEND_API_KEY
# and EMAIL_FROM above; without them the checks still run and log, but cannot page.
# ALERT_TO=ops@example.com
# Disk usage percentage that counts as a problem. Default 85.
# ALERT_DISK_PERCENT=85
# Hours before re-mailing about a problem that is still present. Default 6 — with
# a 10-minute timer, 0 would mean 144 identical emails a day.
# ALERT_REPEAT_HOURS=6
# Alert if the newest backup run is older than this. Default 48h (one missed
# nightly plus grace); 0 disables. Only fires once $BACKUP_DIR exists, i.e. once
# backups have run at least one time — a deploy that never set them up is not
# nagged every ten minutes.
# ALERT_BACKUP_MAX_AGE_HOURS=48
# BACKUP_DIR=/var/backups/dullahan
# OPTIONAL external dead-man's-switch (healthchecks.io or similar). Pinged on
# success, `<url>/fail` on failure. Unset is fine — the checks above cover
# everything on this box. What they cannot cover is the box itself being gone,
# because nothing running on it can report its own absence. Add this when you want
# that covered.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
# Where selfcheck keeps counter baselines and alert throttles between runs.
# Relative to the unit's WorkingDirectory (/opt/dullahan).
# SELFCHECK_STATE_PATH=selfcheck-state.json
