[Unit]
Description=dullahan backup restore drill
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/dullahan-restore-drill
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

# Makes sudo unusable even for a root unit; the script uses setpriv instead.
NoNewPrivileges=true
PrivateTmp=true
# Hides /root, so anything reading a dotfile there (rclone's config, most
# obviously) must be pointed at /etc/dullahan instead.
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/backups
